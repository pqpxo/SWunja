#!/usr/bin/env python3
"""swjtrack: sends work you do in tracked folders (and Claude Code sessions) to SWunja's Activity inbox.

  swjtrack -f DIR [-i 30m]    track a folder (default check-in interval 2h)
  swjtrack stop -f DIR        stop tracking it (sync first, or add --discard)
  swjtrack status             what is tracked and waiting
  swjtrack sync [-f DIR]      send waiting activity now
  swjtrack ignore GLOB        never record paths matching GLOB
  swjtrack claude-setup       add the Claude Code SessionEnd hook
  swjtrack claude-hook        (run by Claude Code) report a finished session

Only file names, change counts, commands and commit messages are sent, never file contents;
passwords and tokens in commands are masked before anything leaves this machine.
Standard library only; config in ~/.config/swjtrack/config.json (server, token).
"""
from __future__ import annotations

import datetime
import fnmatch
import getpass
import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

VERSION = '1.0.0'
CONFIG = Path.home() / '.config' / 'swjtrack' / 'config.json'
CAPS = {'prompts': 50, 'commands': 500, 'files': 1000, 'commits': 200}


class SyncError(Exception):
    pass


# ---------------- config and server ----------------

def load_config(path: Path = CONFIG) -> dict:
    try:
        return json.loads(Path(path).read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return {}


def save_config(cfg: dict, path: Path = CONFIG) -> None:
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    # created readable by you only from the start (it holds the API token)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write(json.dumps(cfg, indent=1))
    try:
        os.chmod(path, 0o600)  # an older file keeps its mode through O_TRUNC
    except OSError:
        pass


def post(cfg: dict, route: str, body: dict, timeout: float = 10) -> dict:
    """POST JSON to SWunja; SyncError when it is unreachable or says no."""
    if not cfg.get('server') or not cfg.get('token'):
        raise SyncError('not set up: run the installer, or put server and token in ' + str(CONFIG))
    req = urllib.request.Request(cfg['server'].rstrip('/') + route, data=json.dumps(body).encode(), method='POST',
                                 headers={'content-type': 'application/json', 'authorization': 'Bearer ' + cfg['token']})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read() or b'{}')
    except urllib.error.HTTPError as e:
        raise SyncError(f'{e.code} {e.read()[:200].decode(errors="replace")}') from e
    except (urllib.error.URLError, OSError, ValueError) as e:
        raise SyncError(str(e)) from e


def post_activity(cfg: dict, item: dict) -> dict:
    return post(cfg, '/api/activity', item)


# ---------------- redaction (same rules as the server) ----------------

MASK = '••••'
VAL = r'''("[^"]*"|'[^']*'|[^\s&'"]+)'''  # "quoted", 'quoted', or a bare word
SECRETS = [
    (re.compile(r"(Authorization:\s*(?:Bearer|Basic|Token)?\s*)[^\s'\"]+", re.I), r'\1' + MASK),
    (re.compile(r"(\bBearer\s+)[^\s'\"]+", re.I), r'\1' + MASK),
    (re.compile(r"(\b[A-Za-z-]*(?:Key|Token|Secret):\s*)[^\s'\"]+", re.I), r'\1' + MASK),
    (re.compile(r'(--password[= ])' + VAL, re.I), r'\1' + MASK),
    (re.compile(r'(\bsshpass\s+-p\s*)\S+'), r'\1' + MASK),
    (re.compile(r'(\s-u\s*[^:\s]+:)\S+'), r'\1' + MASK),
    (re.compile(r'(://[^:/\s@]+:)[^@\s]+(@)'), r'\1' + MASK + r'\2'),
    (re.compile(r'(\b(?:export\s+)?[A-Za-z0-9_]*(?:KEY|TOKEN|SECRET|PASS)[A-Za-z0-9_]*=)' + VAL, re.I), r'\1' + MASK),
    (re.compile(r'(\b(?:password|passwd|pwd|token|api_key|apikey|secret)=)' + VAL, re.I), r'\1' + MASK),
    (re.compile(r'(\b(?:password|passwd|secret|token):\s+)\S+', re.I), r'\1' + MASK),
    (re.compile(r'\b(?=[A-Za-z0-9+=_-]*\d)(?=[A-Za-z0-9+=_-]*[A-Za-z])[A-Za-z0-9+=_-]{32,}'), MASK),
]


MYSQL = re.compile(r'\b(?:mysql|mysqldump|mysqladmin|mariadb)[\w-]*\b', re.I)
ATTACHED_P = re.compile(r'(\s-p)(?=[^\s-])\S+')


def redact(text: str) -> str:
    for pattern, rep in SECRETS:
        text = pattern.sub(rep, text)
    # -psecret is a password only for MySQL/MariaDB tools; elsewhere -p is a port (docker -p8080:80, ssh -p2222)
    return ATTACHED_P.sub(r'\1' + MASK, text) if MYSQL.search(text) else text


# ---------------- Claude Code ----------------

EDIT_TOOLS = {'Edit', 'MultiEdit', 'Write', 'NotebookEdit'}
SHELL_TOOLS = {'Bash', 'PowerShell'}


def parse_transcript(path: str) -> dict:
    """What a Claude Code session did, read line by line from its JSONL transcript (caps keep big sessions cheap)."""
    prompts, commands, files = [], [], {}
    started = ended = None
    with open(path, encoding='utf-8', errors='replace') as f:
        for line in f:
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if not isinstance(d, dict):
                continue
            ts = d.get('timestamp')
            if ts:
                started = started or ts
                ended = ts
            msg = d.get('message') if isinstance(d.get('message'), dict) else {}
            content = msg.get('content')
            if d.get('type') == 'user' and not d.get('isMeta') and not d.get('isCompactSummary'):  # skip injected skill text and summaries
                texts = [content] if isinstance(content, str) else [b.get('text', '') for b in content or [] if isinstance(b, dict) and b.get('type') == 'text']
                for t in texts:
                    t = t.strip()
                    if t and not t.startswith('<') and len(prompts) < CAPS['prompts']:
                        prompts.append(redact(t)[:2000])
            elif d.get('type') == 'assistant' and isinstance(content, list):
                for b in content:
                    if not isinstance(b, dict) or b.get('type') != 'tool_use':
                        continue
                    name, inp = b.get('name'), b.get('input') or {}
                    if name in EDIT_TOOLS and inp.get('file_path') or name == 'NotebookEdit' and inp.get('notebook_path'):
                        p = inp.get('file_path') or inp.get('notebook_path')
                        if p in files:
                            files[p]['count'] += 1
                        elif len(files) < CAPS['files']:
                            files[p] = {'path': p, 'change': 'created' if name == 'Write' else 'edited', 'count': 1}
                    elif name in SHELL_TOOLS and inp.get('command') and len(commands) < CAPS['commands']:
                        commands.append({'cmd': redact(str(inp['command']))[:1000], 'at': ts})
    return {'prompts': prompts, 'commands': commands, 'files': list(files.values()), 'started': started, 'ended': ended}


def cmd_claude_hook(event: dict, cfg: dict | None = None) -> int:
    """Claude Code SessionEnd hook: report the session. Always exits 0 so it can never get in Claude Code's way."""
    cfg = load_config() if cfg is None else cfg
    try:
        r = parse_transcript(event['transcript_path'])
        if not r['files'] and not r['commands']:
            return 0
        sid = str(event.get('session_id') or '')
        post_activity(cfg, {'source': 'claude-code', 'host': socket.gethostname(), 'folder': event.get('cwd') or os.getcwd(),
                            'batch_id': 'cc-' + sid, 'session_id': sid, **r})
    except Exception as e:  # noqa: BLE001 - a hook must never get in Claude Code's way
        print(f'swjtrack: could not report this session: {e}', file=sys.stderr)
    return 0


def cmd_claude_setup(settings_path: str | None = None) -> int:
    """Adds `swjtrack claude-hook` as a SessionEnd hook in Claude Code's settings (once; other settings kept)."""
    path = Path(settings_path) if settings_path else Path.home() / '.claude' / 'settings.json'
    try:
        settings = json.loads(path.read_text(encoding='utf-8')) if path.exists() else {}
    except ValueError:
        print(f'swjtrack: {path} is not valid JSON; not changed', file=sys.stderr)
        return 1
    entries = settings.setdefault('hooks', {}).setdefault('SessionEnd', [])
    if any('swjtrack' in h.get('command', '') and 'claude-hook' in h.get('command', '') for e in entries for h in e.get('hooks', [])):
        print('swjtrack: the Claude Code hook is already set up')
        return 0
    command = f'"{sys.executable}" "{Path(__file__).resolve()}" claude-hook'
    entries.append({'hooks': [{'type': 'command', 'command': command}]})
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(settings, indent=2), encoding='utf-8')
    print(f'swjtrack: Claude Code will report each session to SWunja ({path})')
    return 0


# ---------------- tracked folders: state lives in ~/.local/share/swjtrack ----------------

def state_dir() -> Path:
    d = Path(os.environ.get('SWJTRACK_HOME') or Path.home() / '.local' / 'share' / 'swjtrack')
    d.mkdir(parents=True, exist_ok=True)
    return d


def _read_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return default


def _write_text(path: Path, text: str) -> None:
    """Atomic: a unique temp file, then rename, so shells writing at the same moment never see half a file."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + '.', suffix='.tmp')
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write(text)
    for attempt in range(20):
        try:
            os.replace(tmp, path)
            return
        except PermissionError:  # Windows: the target is open in another process for a moment
            time.sleep(0.01 * (attempt + 1))
    os.replace(tmp, path)


def _write_json(path: Path, data) -> None:
    _write_text(path, json.dumps(data))


def tracked() -> dict:
    """{folder: {interval_s, since, last_sync, last_prompt, snooze_until, last_hist}} (times are epoch seconds)."""
    return _read_json(state_dir() / 'folders.json', {})


def _save_tracked(folders: dict) -> None:
    _write_json(state_dir() / 'folders.json', folders)
    # the shell hook reads this plain list to decide (without starting Python) whether $PWD is tracked
    (state_dir() / 'folders.txt').write_text(''.join(f + '\n' for f in folders), encoding='utf-8')


def _key(folder: str) -> str:
    return hashlib.sha1(folder.encode()).hexdigest()[:16]


def _events_path(folder: str) -> Path:
    return state_dir() / (_key(folder) + '.jsonl')


def _snap_path(folder: str) -> Path:
    return state_dir() / (_key(folder) + '.snap.json')


def _append(folder: str, event: dict) -> None:
    with open(_events_path(folder), 'a', encoding='utf-8') as f:
        f.write(json.dumps(event) + '\n')


def _events(folder: str) -> list:
    try:
        lines = _events_path(folder).read_text(encoding='utf-8').splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def track(folder: str, interval_s: int = 7200) -> str:
    folder = os.path.abspath(os.path.expanduser(folder))
    if not os.path.isdir(folder):
        raise SystemExit(f'swjtrack: {folder} is not a folder')
    folders = tracked()
    folders.setdefault(folder, {'since': time.time()})['interval_s'] = int(interval_s)
    _save_tracked(folders)
    _write_json(_snap_path(folder), _scan(folder))  # what's already there doesn't count as created
    return folder


def untrack(folder: str, cfg: dict | None = None) -> None:
    """Stops tracking and drops anything still waiting there; tells SWunja so its reminders stop."""
    folder = os.path.abspath(os.path.expanduser(folder))
    folders = tracked()
    folders.pop(folder, None)
    _save_tracked(folders)
    for p in (_events_path(folder), _snap_path(folder)):
        try:
            p.unlink()
        except OSError:
            pass
    heartbeat(cfg, folder)  # nothing waiting now


def folder_for(cwd: str) -> str | None:
    """The tracked folder that contains cwd (the deepest one)."""
    cwd = os.path.abspath(cwd)
    hits = [f for f in tracked() if cwd == f or cwd.startswith(f.rstrip(os.sep) + os.sep)]
    return max(hits, key=len) if hits else None


def ignores() -> list:
    return _read_json(state_dir() / 'ignore.json', [])


def add_ignore(glob: str) -> None:
    globs = ignores()
    if glob not in globs:
        _write_json(state_dir() / 'ignore.json', globs + [glob])


# ---------------- capture ----------------

SKIP_DIRS = {'.git', 'node_modules', '__pycache__', '.venv', 'venv', '.cache'}
# files that change constantly on their own (database journals, logs, editor swap files)
NOISE = ['*.db-wal', '*.db-shm', '*.sqlite-wal', '*.sqlite-shm', '*-journal', '*.log', '*.swp', '*~', '.DS_Store']
MAX_FILES = 50000


def _scan(folder: str) -> dict:
    """{relative path: mtime} for every file under folder, skipping noise and ignored paths."""
    out, globs = {}, NOISE + ignores()
    for root, dirs, files in os.walk(folder):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for name in files:
            full = os.path.join(root, name)
            rel = os.path.relpath(full, folder)
            if any(fnmatch.fnmatch(rel, g) or fnmatch.fnmatch(name, g) for g in globs):
                continue
            try:
                out[rel] = os.stat(full).st_mtime
            except OSError:
                continue
            if len(out) >= MAX_FILES:
                return out
    return out


def watch_once(folder: str, now: float | None = None) -> int:
    """Compares the folder with its last scan and records created / edited / deleted files. Returns how many changed."""
    now = time.time() if now is None else now
    before, after = _read_json(_snap_path(folder), {}), _scan(folder)
    changes = [(p, 'created') for p in after if p not in before] + [(p, 'edited') for p in after if p in before and after[p] != before[p]] \
        + [(p, 'deleted') for p in before if p not in after]
    # a file already waiting as created/edited needs no second "edited" (a busy file would add one every scan)
    waiting = {e['path'] for e in _events(folder) if e.get('kind') == 'file' and e.get('change') in ('created', 'edited')} if changes else set()
    for rel, change in changes:
        path = os.path.join(folder, rel)
        if change == 'edited' and path in waiting:
            continue
        _append(folder, {'t': now, 'kind': 'file', 'path': path, 'change': change})
    if changes or not _snap_path(folder).exists():
        _write_json(_snap_path(folder), after)
    return len(changes)


def pending_count(folder: str, events: list | None = None) -> int:
    """What a person would call "activities": each file once, plus each command."""
    events = _events(folder) if events is None else events
    return len({e['path'] for e in events if e.get('kind') == 'file'}) + sum(1 for e in events if e.get('kind') == 'cmd')


def _hist_cmd(histline: str) -> str:
    """'  512  make build' (bash/zsh `fc -l -1` or `history 1`) -> 'make build'."""
    return re.sub(r'^\s*\d+\*?\s+', '', histline or '').strip()


def record_cmd(cwd: str, histline: str, exit_code: int, now: float | None = None) -> bool:
    folder = folder_for(cwd)
    cmd = _hist_cmd(histline)
    if not folder or not cmd or cmd.split()[0] == 'swjtrack':
        return False
    folders = tracked()
    if folders[folder].get('last_hist') == histline.strip():  # Enter on an empty prompt repeats the last history line
        return False
    folders[folder]['last_hist'] = histline.strip()
    _save_tracked(folders)
    _append(folder, {'t': time.time() if now is None else now, 'kind': 'cmd', 'cmd': redact(cmd)[:1000], 'exit': int(exit_code)})
    return True


def _iso(t: float) -> str:
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def _commits(folder: str, since: float) -> list:
    if not os.path.isdir(os.path.join(folder, '.git')) or not shutil.which('git'):
        return []
    try:
        out = subprocess.run(['git', '-C', folder, 'log', f'--since={_iso(since - 1)}', '--pretty=%h%x09%s'],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    return [{'hash': h, 'message': redact(m)[:300]} for h, _, m in (l.partition('\t') for l in out.splitlines() if l)][:CAPS['commits']]


def collect(folder: str, limit: int | None = None) -> dict:
    """Everything waiting for this folder (or its first `limit` events), shaped for POST /api/activity."""
    folder = os.path.abspath(folder)
    st = tracked().get(folder, {})
    events = _events(folder)[:limit]
    files = {}
    for e in events:
        if e.get('kind') == 'file':
            f = files.setdefault(e['path'], {'path': e['path'], 'change': e['change'], 'count': 0})
            f['change'] = e['change']
            f['count'] += 1
    commands = [{'cmd': e['cmd'], 'exit': e.get('exit', 0), 'at': _iso(e['t'])} for e in events if e.get('kind') == 'cmd']
    times = [e['t'] for e in events]
    return {'folder': folder, 'files': list(files.values())[:CAPS['files']], 'commands': commands[-CAPS['commands']:],
            'commits': _commits(folder, st.get('last_sync') or st.get('since') or time.time()),
            'started': _iso(min(times)) if times else None, 'ended': _iso(max(times)) if times else None, 'events': len(events)}


def sync(cfg: dict | None = None, folder: str | None = None) -> list:
    """Sends each folder's waiting activity as one item; local activity is trimmed only after the server took it."""
    cfg = load_config() if cfg is None else cfg
    ids = []
    for f in ([os.path.abspath(folder)] if folder else list(tracked())):
        while True:
            # a batch whose reply was lost is sent again as exactly the same batch (same events, same id),
            # so SWunja keeps one copy; anything recorded since goes in the next batch
            pending = tracked().get(f, {}).get('pending')
            data = collect(f, pending['n'] if pending else None)
            n = data.pop('events')
            if not n and not data['commits']:
                break
            batch = pending['batch_id'] if pending else 'sw-' + _key(f + str(n) + str(time.time()))
            if not pending:
                _set_state(f, pending={'batch_id': batch, 'n': n})
            ids.append(post_activity(cfg, {'source': 'swjtrack', 'host': socket.gethostname(), 'batch_id': batch, **data}).get('id'))
            # keep anything recorded while we were sending (rewritten from what parses, so a damaged line can't shift the count)
            _write_text(_events_path(f), ''.join(json.dumps(e) + '\n' for e in _events(f)[n:]))
            _set_state(f, pending=None, last_sync=time.time())
            heartbeat(cfg, f)
            if not pending:
                break
    return ids


def _set_state(folder: str, **values) -> None:
    folders = tracked()
    if folder in folders:
        for k, v in values.items():
            if v is None:
                folders[folder].pop(k, None)
            else:
                folders[folder][k] = v
        _save_tracked(folders)


def heartbeat(cfg: dict | None, folder: str, now: float | None = None) -> None:
    """Tells SWunja how much is waiting here, for its "have you synced?" reminders. Never raises; 2 s at most."""
    cfg = load_config() if cfg is None else cfg
    if not cfg.get('server'):
        return
    events = _events(folder)
    try:
        post(cfg, '/api/activity/heartbeat', {'host': socket.gethostname(), 'folder': folder, 'unsynced_count': pending_count(folder, events),
                                               'oldest': _iso(min(e['t'] for e in events)) if events else None}, timeout=2)
    except SyncError:
        pass
    folders = tracked()
    if folder in folders:
        folders[folder]['last_beat'] = time.time() if now is None else now
        _save_tracked(folders)


# ---------------- background watcher and the shell hook ----------------

def ensure_watcher() -> None:
    """Starts the background folder watcher unless it is already running."""
    pid_file = state_dir() / 'watcher.pid'
    try:
        os.kill(int(pid_file.read_text()), 0)
        return
    except (OSError, ValueError):
        pass
    p = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), '_watch'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    pid_file.write_text(str(p.pid))


def watcher_loop(every: float = 5) -> None:
    pid_file = state_dir() / 'watcher.pid'
    pid_file.write_text(str(os.getpid()))
    # ponytail: polls mtimes every 5 s instead of inotify; fine for project-sized folders, switch to inotifywait if a folder has 100k+ files
    while tracked() and pid_file.read_text().strip() == str(os.getpid()):
        for f in list(tracked()):
            if os.path.isdir(f):
                watch_once(f)
        time.sleep(every)


def _tty_ask(question: str) -> str | None:
    try:
        # unbuffered binary: text mode 'r+' raises on a terminal (it isn't seekable)
        with open('/dev/tty', 'rb+', buffering=0) as tty:
            tty.write(question.encode())
            return tty.readline().decode(errors='replace').strip()
    except OSError:
        return None


def cmd_hook(exit_code: int, cwd: str, histline: str, now: float | None = None, ask=_tty_ask, cfg: dict | None = None) -> int:
    """Runs before each shell prompt inside a tracked folder: records the command and, when the folder is due, asks to sync."""
    now = time.time() if now is None else now
    record_cmd(cwd, histline, exit_code, now)
    folder = folder_for(cwd)
    if not folder:
        return 0
    if now - (tracked()[folder].get('last_beat') or 0) >= 600:
        heartbeat(cfg, folder, now)
    if ask is None:
        return 0
    st = tracked()[folder]
    last = max(st.get('since', 0), st.get('last_sync') or 0, st.get('last_prompt') or 0)
    events = _events(folder)
    if not events or now - last < st.get('interval_s', 7200) or now < (st.get('snooze_until') or 0):
        return 0
    when = time.strftime('%H:%M', time.localtime(min(e['t'] for e in events)))
    question = f'{pending_count(folder, events)} activities for {folder} since {when}. Sync to SWunja? [Y/n/show] '
    answer = ask(question)
    if answer is not None and answer.lower().startswith('s'):
        for e in events[-30:]:
            print('  ' + (e.get('cmd') if e.get('kind') == 'cmd' else f"{e.get('change')} {e.get('path')}"))
        answer = ask(question)
    folders = tracked()
    folders[folder]['last_prompt'] = now
    if answer is not None and answer.lower().startswith('n'):
        folders[folder]['snooze_until'] = now + st.get('interval_s', 7200)
    _save_tracked(folders)
    if answer is not None and not answer.lower().startswith('n'):
        try:
            sync(cfg, folder)
            print('swjtrack: synced to SWunja')
        except SyncError as e:
            print(f'swjtrack: sync failed ({e}); kept locally, try `swjtrack sync` later')
    return 0


HOOK_START, HOOK_END = '# >>> swjtrack >>>', '# <<< swjtrack <<<'
SHELL_HOOK = HOOK_START + r'''
# records commands run inside folders tracked with `swjtrack -f`, and asks to sync when due
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
case $- in *i*)
__swj_hook() {
  local e=$? d f="${SWJTRACK_HOME:-$HOME/.local/share/swjtrack}/folders.txt"
  [ -r "$f" ] || return $e
  while IFS= read -r d; do
    case "$PWD/" in "$d"/*) "$HOME/.local/bin/swjtrack" _hook "$e" "$PWD" "$(fc -l -1 2>/dev/null)"; break ;; esac
  done < "$f"
  return $e
}
if [ -n "$ZSH_VERSION" ]; then autoload -Uz add-zsh-hook && add-zsh-hook precmd __swj_hook
else case "$PROMPT_COMMAND" in *__swj_hook*) ;; *) PROMPT_COMMAND="__swj_hook${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;; esac
fi ;;
esac
''' + HOOK_END + '\n'


def install_shell_hook(rc_path: str) -> bool:
    """Adds the hook block to a shell rc file, or replaces an older version of it. Returns True if the file changed."""
    rc = Path(rc_path)
    text = rc.read_text(encoding='utf-8') if rc.exists() else ''
    start, end = text.find(HOOK_START), text.find(HOOK_END)
    if start >= 0 and end > start:
        stop = end + len(HOOK_END) + (1 if text[end + len(HOOK_END):].startswith('\n') else 0)
        new = text[:start] + SHELL_HOOK + text[stop:]
    else:
        new = text + ('' if not text or text.endswith('\n') else '\n') + SHELL_HOOK
    if new == text:
        return False
    with open(rc, 'w', encoding='utf-8', newline='\n') as f:  # Linux line endings even when written from Windows
        f.write(new)
    return True


def parse_interval(s: str) -> int:
    m = re.fullmatch(r'(\d+)\s*([smhd]?)', s.strip().lower())
    if not m:
        raise SystemExit(f'swjtrack: interval {s!r} should look like 30m, 2h or 1d')
    return int(m.group(1)) * {'s': 1, 'm': 60, 'h': 3600, 'd': 86400, '': 60}[m.group(2)]


# ---------------- command line ----------------

def cmd_setup(server: str, token: str | None = None, cfg_path: Path = CONFIG, rc_files: list | None = None) -> int:
    """Run by the installer: saves the server and token (readable only by you) and adds the shell hook."""
    # the token never goes on a command line (ps, shell history): SWJTRACK_TOKEN, or typed without echo
    token = token or os.environ.get('SWJTRACK_TOKEN') or getpass.getpass('SWunja API token (Settings > API Tokens & MCP): ')
    save_config({'server': server.rstrip('/'), 'token': token.strip()}, cfg_path)
    if rc_files is None and os.name == 'nt':
        rc_files = []  # Windows: only the Claude Code hook is used there
    if rc_files is None:
        rc_files = [str(Path.home() / '.bashrc')] + ([str(Path.home() / '.zshrc')] if (Path.home() / '.zshrc').exists() else [])
    for rc in rc_files:
        if install_shell_hook(rc):
            print(f'swjtrack: shell hook set up in {rc}')
    return 0


def cmd_status() -> int:
    folders = tracked()
    if not folders:
        print('Nothing tracked. Start with: swjtrack -f ~/path/to/folder')
    for f, st in folders.items():
        n = len(_events(f))
        last = time.strftime('%d %b %H:%M', time.localtime(st['last_sync'])) if st.get('last_sync') else 'never'
        print(f'{f}\n  {n} waiting · last synced {last} · check-in every {st.get("interval_s", 7200) // 60} min')
    cfg = load_config()
    print(f'Server: {cfg.get("server") or "not set (run the installer)"}')
    return 0


def check_token(server: str, token: str) -> bool:
    """True when SWunja accepts the token; SyncError when SWunja can't be reached at all."""
    req = urllib.request.Request(server.rstrip('/') + '/api/activity/count', headers={'authorization': 'Bearer ' + token})
    try:
        with urllib.request.urlopen(req, timeout=5):
            return True
    except urllib.error.HTTPError as e:
        e.close()
        if e.code in (401, 403):
            return False
        raise SyncError(f'{e.code} from {server}') from e
    except (urllib.error.URLError, OSError) as e:
        raise SyncError(str(e)) from e


def cmd_install(server: str, say=print, **kw) -> int:
    """Runs the setup; Ctrl+C or the end of input stops it cleanly (whatever was already confirmed stays saved)."""
    try:
        return _install(server, say=say, **kw)
    except (EOFError, KeyboardInterrupt):
        say('\nSetup cancelled. Run the installer again any time.')
        return 1


def _install(server: str, ask=None, ask_secret=None, say=print, cfg_path: Path = CONFIG, rc_files: list | None = None,
                docker_dir: str | None = None, cwd: str | None = None, claude_found: bool | None = None, claude_settings: str | None = None) -> int:
    """The installer's interactive setup: API token (checked), folders to track, check-in interval, Claude Code hook."""
    ask = ask or (lambda q: _tty_ask(q) or '')
    ask_secret = ask_secret or getpass.getpass
    server = server.rstrip('/')
    cwd = cwd or os.getcwd()
    docker_dir = docker_dir or str(Path.home() / 'docker')
    if claude_found is None:
        claude_found = bool(shutil.which('claude')) or (Path.home() / '.claude').is_dir()
    say(f'\nSWunja activity tracker setup for {socket.gethostname()}\n')

    # 1. API token
    say('Step 1  API token')
    token, saved = None, load_config(cfg_path).get('token')
    try:
        if saved and check_token(server, saved) and not ask('  A token is already saved and works. Keep it? [Y/n] ').strip().lower().startswith('n'):
            token = saved
        if not token:
            say(f'  Create a token in SWunja (Settings > API Tokens & MCP), named after this host:\n  {server}/#/settings/tokens')
            for _ in range(3):
                candidate = ask_secret('  Paste the token (it stays hidden): ').strip()
                if candidate and check_token(server, candidate):
                    token = candidate
                    break
                say('  That token was not accepted; check you copied all of it.')
    except SyncError as e:
        say(f'  Could not reach SWunja at {server} ({e}). Check the address and that it is running, then run the installer again.')
        return 1
    if not token:
        say('  Giving up after three tries; nothing was changed. Run the installer again when you have a token.')
        return 1
    save_config({'server': server, 'token': token}, cfg_path)
    say('  Token works and is saved (readable only by you).\n')

    # 2. folders
    say('Step 2  Folders to track')
    choices = sorted(d.name for d in Path(docker_dir).iterdir() if d.is_dir()) if os.path.isdir(docker_dir) else []
    for i, name in enumerate(choices, 1):
        say(f'  {i}) {name}' + ('' if i > 1 else f'   (in {docker_dir})'))
    answer = ask(f'  Numbers and/or paths, separated by spaces. Enter = this folder ({cwd}), "none" = skip: ').strip()
    folders = []
    for part in ([] if answer.lower() == 'none' else answer.split() or [cwd]):
        path = os.path.join(docker_dir, choices[int(part) - 1]) if part.isdigit() and 0 < int(part) <= len(choices) else os.path.abspath(os.path.expanduser(part))
        if os.path.isdir(path):
            folders.append(path)
        else:
            say(f'  Skipped {part}: not a folder')
    if folders:
        interval = 7200
        text = ask('  Ask to sync after how long? e.g. 30m, 2h, 1d [2h]: ').strip()
        try:
            interval = parse_interval(text) if text else 7200
        except SystemExit:
            say('  Not a time like 30m or 2h; using 2h.')
        for f in folders:
            track(f, interval)
            say(f'  Tracking {f}')
        if not os.environ.get('SWJTRACK_NO_WATCH'):
            ensure_watcher()
    say('')

    # 3. Claude Code
    if claude_found:
        say('Step 3  Claude Code')
        if ask('  Claude Code is installed here. Report each of its sessions to SWunja too? [y/N] ').strip().lower().startswith('y'):
            cmd_claude_setup(claude_settings)
        say('')

    # shell hook: records commands typed in tracked folders and asks to sync when due
    if rc_files is None:
        rc_files = [] if os.name == 'nt' else [str(Path.home() / '.bashrc')] + ([str(Path.home() / '.zshrc')] if (Path.home() / '.zshrc').exists() else [])
    for rc in rc_files:
        install_shell_hook(rc)
    say('All set. Now run:\n\n    exec bash\n\nThat starts swjtrack in this shell (new shells pick it up by themselves). Check on it any time with: swjtrack status')
    return 0


def _folder_arg(argv: list) -> str | None:
    return argv[argv.index('-f') + 1] if '-f' in argv and argv.index('-f') + 1 < len(argv) else None


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd == '-f':
        folder = _folder_arg(argv)
        if not folder:
            print('swjtrack: -f needs a folder', file=sys.stderr)
            return 2
        interval = parse_interval(argv[argv.index('-i') + 1]) if '-i' in argv else 7200
        f = track(folder, interval)
        if not os.environ.get('SWJTRACK_NO_WATCH'):
            ensure_watcher()
        print(f'swjtrack: tracking {f}; you will be asked to sync every {interval // 60} min of activity (swjtrack sync sends it now)')
        return 0
    if cmd == 'stop':
        folder = _folder_arg(argv)
        if not folder:
            print('swjtrack: stop -f FOLDER', file=sys.stderr)
            return 2
        n = pending_count(os.path.abspath(os.path.expanduser(folder)))
        if n and '--discard' not in argv:
            print(f'swjtrack: {n} activities here are not synced yet. Run `swjtrack sync -f {folder}` first, or add --discard to drop them.', file=sys.stderr)
            return 1
        untrack(folder)
        print(f'swjtrack: stopped tracking {os.path.abspath(folder)}')
        return 0
    if cmd == 'status':
        return cmd_status()
    if cmd == 'sync':
        try:
            ids = sync(None, _folder_arg(argv))
        except SyncError as e:
            print(f'swjtrack: sync failed ({e}); activity kept locally', file=sys.stderr)
            return 1
        print(f'swjtrack: sent {len(ids)} item{"s" if len(ids) != 1 else ""} to SWunja' if ids else 'swjtrack: nothing to send')
        return 0
    if cmd == 'ignore' and len(argv) > 1:
        add_ignore(argv[1])
        print(f'swjtrack: ignoring {argv[1]}')
        return 0
    if cmd == '_hook' and len(argv) >= 3:
        if not os.environ.get('SWJTRACK_NO_WATCH'):
            ensure_watcher()
        return cmd_hook(int(argv[1]) if argv[1].isdigit() else 0, argv[2], argv[3] if len(argv) > 3 else '')
    if cmd == '_watch':
        watcher_loop()
        return 0
    if cmd == '_install' and len(argv) == 2:
        return cmd_install(argv[1])
    if cmd == '_setup' and len(argv) >= 2:
        return cmd_setup(argv[1], argv[2] if len(argv) > 2 else None)
    if cmd == 'claude-hook':
        try:
            event = json.load(sys.stdin)
        except ValueError:
            return 0
        return cmd_claude_hook(event)
    if cmd == 'claude-setup':
        return cmd_claude_setup(argv[1] if len(argv) > 1 else None)
    if cmd == '--version':
        print(VERSION)
        return 0
    print(f'swjtrack: unknown command {cmd!r} (swjtrack --help)', file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
